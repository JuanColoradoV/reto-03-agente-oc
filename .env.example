# Variables de entorno (sin valores). En local, wrangler lee .dev.vars (misma sintaxis); en producción: `wrangler secret put ANTHROPIC_API_KEY`.

# Clave del proveedor LLM (solo backend; nunca en el front, el repo ni los logs).
ANTHROPIC_API_KEY=
# Modelo (por defecto claude-sonnet-5-5).
LLM_MODEL=
# 1 = modelo simulado con guion (solo localhost): recorre el flujo sin clave.
MOCK_LLM=

# Límites de costo y robustez (todos opcionales; entre paréntesis, el valor por defecto).
# Tope de iteraciones herramienta -> modelo por turno (25).
ITER_MAX=
# Tope de tokens (entrada + salida) acumulados por sesión (400000).
TOKENS_SESION_MAX=
# Timeout de cada llamada al modelo en milisegundos (90000).
LLM_TIMEOUT_MS=
# Tope diario global estimado en USD (5).
DAILY_BUDGET_USD=
