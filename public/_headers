# Cabeceras de los assets estaticos (los de /api/* los pone el Worker en src/api.ts: mantener ambos en sincronia).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: SAMEORIGIN

# Cache-busting sin paso de build: app.js, styles.css y la pagina se REVALIDAN siempre (no-cache = guardar pero preguntar con ETag
# antes de usar; si no cambio responde 304 sin cuerpo). Asi un despliegue nuevo nunca queda tapado por un app.js viejo en el navegador.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/app.js
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
